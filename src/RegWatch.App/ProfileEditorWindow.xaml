<Window x:Class="RegWatch.App.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegWatch profile" Height="780" Width="980" MinWidth="700" MinHeight="480"
        Background="{DynamicResource ApplicationBackgroundBrush}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Import…" Click="Import_Click" ToolTip="Replace this profile with a PROFILE.md file (yours is backed up first)" />
                    <Button Content="Export…" Click="Export_Click" ToolTip="Save a copy of this profile to share" />
                    <Button Content="Open in text editor" Click="OpenExternal_Click" ToolTip="Open PROFILE.md in your default editor" />
                    <Button Content="Revert" Click="Revert_Click" ToolTip="Discard unsaved changes and reload PROFILE.md" />
                    <Button Content="Save" FontWeight="SemiBold" IsDefault="False" Click="Save_Click" />
                    <Button Content="Close" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" Margin="10,10,10,0"
                    SelectionChanged="Tabs_SelectionChanged">

            <!-- Topic buckets -->
            <TabItem x:Name="BucketsTab" Header="Topic buckets">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,8,2,10">
                        <Button DockPanel.Dock="Right" Content="+ Add bucket" Click="AddBucket_Click" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                            An item scores the weight of the highest bucket it matches, minus 1 for a passing mention.
                            The score decides where it lands in the digest: 3 opens the digest under "read now",
                            2 comes next under "read this week", 1 under "skim", and 0 is just a one-line entry under Skip.
                            Terms are the IRC sections, forms and phrases that signal the bucket.
                        </TextBlock>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BucketList" Margin="2,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="5" CornerRadius="6,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Weight}" Value="3">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Weight}" Value="2">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Weight}" Value="1">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Margin="12,10,10,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontSize="14"
                                                            ToolTip="Remove this bucket" Click="RemoveBucket_Click" />
                                                    <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,8,0"
                                                              ItemsSource="{Binding DataContext.WeightOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding Weight, Mode=TwoWay}" />
                                                    <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold"
                                                             BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="Transparent" Padding="0,2"
                                                             ToolTip="Bucket key (letters, digits and underscores); appears in digests" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Terms}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="9,3,3,3" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                    <Button Content="✕" Style="{StaticResource IconButton}" FontSize="10" Margin="4,0,0,0"
                                                                            ToolTip="Remove term" Click="RemoveTerm_Click" Tag="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid Margin="0,2,0,0">
                                                    <TextBox x:Name="NewTermBox" Text="{Binding NewTerm, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" KeyDown="NewTerm_KeyDown" />
                                                    <TextBlock Text="Add a term and press Enter (commas add several)" Foreground="{DynamicResource TextFillColorDisabledBrush}" Margin="7,4,0,0"
                                                               IsHitTestVisible="False" Visibility="{Binding NewTermHintVisibility}" />
                                                </Grid>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- False-positive guards -->
            <TabItem x:Name="GuardsTab" Header="False-positive guards">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,8,2,10">
                        <Button DockPanel.Dock="Right" Content="+ Add guard" Click="AddGuard_Click" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                            Applied before any bucket match: terms that look relevant but are not. Markdown is fine,
                            e.g. "REIT" → **0** unless a foreign-holder angle is explicit.
                        </TextBlock>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GuardList" Margin="2,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontSize="14"
                                                    VerticalAlignment="Top" ToolTip="Remove this guard" Click="RemoveGuard_Click" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
                                                     BorderThickness="0" Background="Transparent" Padding="0,2" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Raw Markdown -->
            <TabItem x:Name="RawTab" Header="Raw text">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,2,8" TextWrapping="Wrap">
                        The whole PROFILE.md, including the scoring scale and instructions. Edits here show up in the other tabs
                        when you switch back.
                    </TextBlock>
                    <TextBox x:Name="RawBox" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             TextChanged="RawBox_TextChanged" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
