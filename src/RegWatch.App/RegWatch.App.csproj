<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\RegWatch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\RegWatch.ico" />
    <!-- Seeds a new data folder on first run (see App.CreateDataFolder). A frozen copy, so
         calibrating your own PROFILE.md does not change what new installs start with. -->
    <Content Include="Defaults\PROFILE.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\docs\GUIDE.md" LogicalName="RegWatch.Guide.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RegWatch.Core\RegWatch.Core.csproj" />
  </ItemGroup>

</Project>
