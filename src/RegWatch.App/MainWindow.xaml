<Window x:Class="RegWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RegWatch" Icon="Assets/RegWatch.ico" Height="820" Width="1280" MinWidth="900" MinHeight="560"
        Background="{DynamicResource ApplicationBackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RegWatch" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,1"
                            Margin="10,3,0,0" VerticalAlignment="Center" ToolTip="Early test version: expect rough edges">
                        <TextBlock x:Name="VersionBadge" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RunButton" Content="Run now" FontWeight="SemiBold" Click="Run_Click" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
                    <Button Content="Edit profile" Click="EditProfile_Click" ToolTip="Edit topic buckets, weights and guards (saved to PROFILE.md)" />
                    <Button Content="Open folder" Click="OpenFolder_Click" />
                    <Button Content="Schedule weekly" Click="Schedule_Click" ToolTip="Create or update a Windows Task Scheduler task (Mondays 19:00)" />
                    <Button x:Name="SettingsButton" Click="Settings_Click" ToolTip="Scoring, commentary sources and theme">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Settings" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       VerticalAlignment="Center" Margin="8,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SettingsMenu">
                                <MenuItem x:Name="ScoringMenu" Header="Scoring">
                                    <MenuItem Header="Claude subscription (Claude Code)" Tag="ClaudeCode" Click="ScorerItem_Click" />
                                    <MenuItem Header="Anthropic API key" Tag="AnthropicApi" Click="ScorerItem_Click" />
                                    <MenuItem Header="OpenAI-compatible / local AI" Tag="OpenAiCompatible" Click="ScorerItem_Click" />
                                </MenuItem>
                                <MenuItem Header="Advanced scoring settings…" Click="Advanced_Click"
                                          ToolTip="Models, API keys, OpenAI or local AI servers, connection test" />
                                <MenuItem Header="Scoring feedback…" Click="Feedback_Click"
                                          ToolTip="Your Too high / Too low / Not relevant marks, and whether they reach the scorer" />
                                <MenuItem Header="Sources…" Click="Sources_Click"
                                          ToolTip="Commentary feeds and IRS news releases: The Tax Adviser, JofA, and your own" />
                                <MenuItem x:Name="NotifyItem" Header="Notify after scheduled runs" IsCheckable="True" Click="Notify_Click"
                                          ToolTip="Show a Windows notification when the weekly scheduled run finishes" />
                                <Separator />
                                <MenuItem x:Name="ThemeMenu" Header="Theme">
                                    <MenuItem Header="Match Windows" Tag="System" Click="ThemeItem_Click" />
                                    <MenuItem Header="Light" Tag="Light" Click="ThemeItem_Click" />
                                    <MenuItem Header="Dark" Tag="Dark" Click="ThemeItem_Click" />
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="HelpButton" Click="Help_Click" ToolTip="User guide and version (F1 opens the guide)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Help" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       VerticalAlignment="Center" Margin="8,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="HelpMenu">
                                <MenuItem Header="User guide" InputGestureText="F1" Click="Guide_Click" />
                                <MenuItem Header="Check for updates…" Click="Updates_Click" />
                                <MenuItem Header="About RegWatch" Click="About_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                <Grid>
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search every digest (IRC section, form number, any word)" />
                    <TextBlock Text="Search digests" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox x:Name="FilterBox" Margin="0,6,0,0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All digests" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="Unread" Tag="Unread" />
                    <ComboBoxItem Content="Something scored 3" Tag="Score3" />
                    <ComboBoxItem Content="Something scored 2 or 3" Tag="Score2" />
                </ComboBox>
            </StackPanel>
            <ListBox x:Name="DigestList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="DigestList_SelectionChanged" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Mark all as read" Click="MarkAllRead_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BadgeLevel}" Value="3">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BadgeLevel}" Value="2">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="●" Margin="0,0,6,0" FontSize="9" VerticalAlignment="Center" ToolTip="Not opened yet"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="{Binding Headline}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <TabControl x:Name="Tabs" Grid.Column="2" BorderThickness="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <TabItem Header="Digest">
                    <wv2:WebView2 x:Name="Viewer" />
                </TabItem>
                <TabItem x:Name="DeadlinesTab" Header="Comment deadlines">
                    <DataGrid x:Name="DeadlineGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0"
                              MouseDoubleClick="DeadlineGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Closes" Binding="{Binding Deadline, StringFormat=yyyy-MM-dd}" Width="100" />
                            <DataGridTextColumn Header="Days" Binding="{Binding DaysLeft}" Width="60" />
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Cite}" Width="*" />
                            <DataGridTextColumn Header="Digest" Binding="{Binding DigestName}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="LogTab" Header="Run log">
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="10" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
