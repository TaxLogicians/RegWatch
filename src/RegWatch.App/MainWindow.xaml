<Window x:Class="RegWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RegWatch" Icon="Assets/RegWatch.ico" Height="820" Width="1280" MinWidth="900" MinHeight="560"
        Background="{DynamicResource ApplicationBackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="RegWatch" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RunButton" Content="Run now" FontWeight="SemiBold" Click="Run_Click" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
                    <Button Content="Edit profile" Click="EditProfile_Click" ToolTip="Edit topic buckets, weights and guards (saved to PROFILE.md)" />
                    <Button Content="Sources…" Click="Sources_Click" ToolTip="Commentary feeds: The Tax Adviser, JofA, and your own" />
                    <Button Content="Open folder" Click="OpenFolder_Click" />
                    <Button Content="Schedule weekly" Click="Schedule_Click" ToolTip="Create or update a Windows Task Scheduler task (Mondays 19:00)" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,8,12,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock Text="Scoring:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox x:Name="ScorerBox" Width="270" VerticalContentAlignment="Center"
                              SelectionChanged="ScorerBox_SelectionChanged">
                        <ComboBoxItem Content="Claude subscription (Claude Code)" Tag="ClaudeCode" />
                        <ComboBoxItem Content="Anthropic API key" Tag="AnthropicApi" />
                        <ComboBoxItem Content="OpenAI-compatible / local AI" Tag="OpenAiCompatible" />
                    </ComboBox>
                    <Button Content="Advanced…" Click="Advanced_Click"
                            ToolTip="Scoring settings: models, API keys, OpenAI or local AI servers, connection test" />
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="18,0,6,0" />
                    <ComboBox x:Name="ThemeBox" Width="160" VerticalContentAlignment="Center"
                              ToolTip="Light or dark colours" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Match Windows" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="DigestList" Grid.Column="0" BorderThickness="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                     SelectionChanged="DigestList_SelectionChanged" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BadgeLevel}" Value="3">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BadgeLevel}" Value="2">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="{Binding Headline}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <TabControl x:Name="Tabs" Grid.Column="2" BorderThickness="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <TabItem Header="Digest">
                    <wv2:WebView2 x:Name="Viewer" />
                </TabItem>
                <TabItem x:Name="DeadlinesTab" Header="Comment deadlines">
                    <DataGrid x:Name="DeadlineGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0"
                              MouseDoubleClick="DeadlineGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Closes" Binding="{Binding Deadline, StringFormat=yyyy-MM-dd}" Width="100" />
                            <DataGridTextColumn Header="Days" Binding="{Binding DaysLeft}" Width="60" />
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Cite}" Width="*" />
                            <DataGridTextColumn Header="Digest" Binding="{Binding DigestName}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="LogTab" Header="Run log">
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="10" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
