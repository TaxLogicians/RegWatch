<Window x:Class="RegWatch.App.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commentary sources" Height="760" Width="820" MinWidth="640" MinHeight="480"
        Background="{DynamicResource ApplicationBackgroundBrush}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" FontWeight="SemiBold" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,4">
                <TextBlock Text="Commentary sources" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                           Text="Articles from these feeds are scored with your profile and listed under &quot;In the press&quot;, linked to the IRB or Federal Register item they discuss. RegWatch keeps only each article's headline, short summary and link. The IRB and Federal Register are always read." />

                <ItemsControl x:Name="SourceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,4,10,0"
                                              ToolTip="Read this feed on each run" />
                                    <Button DockPanel.Dock="Right" Content="Remove" VerticalAlignment="Top" Visibility="{Binding RemoveVisibility}"
                                            Click="Remove_Click" />
                                    <TextBlock DockPanel.Dock="Right" Text="Built in" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Top" Margin="8,5,0,0"
                                               Visibility="{Binding BuiltInVisibility}" />
                                    <StackPanel>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="14"
                                                 BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="Transparent" Padding="0,2" />
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="Only categories:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                            <Grid>
                                                <TextBox Text="{Binding CategoriesText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Comma-separated feed categories to keep, e.g. TAX. Leave empty to keep every article." />
                                                <TextBlock Text="all categories" Foreground="{DynamicResource TextFillColorDisabledBrush}" Margin="7,4,0,0" IsHitTestVisible="False"
                                                           Visibility="{Binding CategoriesHintVisibility}" />
                                            </Grid>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,6,0,12">
                    <StackPanel>
                        <TextBlock Text="Add a source" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,8"
                                   Text="Paste a site's address (RegWatch finds its RSS or Atom feed) or the feed address itself. Sites that block automated readers, or have no feed, cannot be added." />
                        <DockPanel>
                            <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find feed" Click="Find_Click" />
                            <TextBox x:Name="AddressBox" KeyDown="AddressBox_KeyDown" />
                        </DockPanel>
                        <TextBlock x:Name="FindStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                        <StackPanel x:Name="FoundPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Feed found" FontWeight="SemiBold" />
                            <TextBlock x:Name="FoundUrl" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                            <TextBlock Text="Latest headlines" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="SampleList" Margin="8,4,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Hint}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewNameBox" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Only categories" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewCategoriesBox" ToolTip="Comma-separated; empty keeps every article" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FoundCategories" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                            </Grid>
                            <Button Content="Add source" HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="SemiBold" Click="Add_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
